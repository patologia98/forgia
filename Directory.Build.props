<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Strict warnings on Domain + Application only -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Forgia.Domain')) Or $(MSBuildProjectName.StartsWith('Forgia.Application'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
