<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Forgia.UI.Views.MainWindow"
        Title="Forgia"
        Width="900" Height="600"
        MinWidth="640" MinHeight="400">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Forgia" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="v0.1.0-alpha" FontSize="14" HorizontalAlignment="Center" Opacity="0.6" />
    </StackPanel>

</Window>
